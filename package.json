{
  "name": "koma-image",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Image creation workspaces with a configurable gateway protocol",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "npm run fonts:build && vite",
    "start": "node --env-file-if-exists=.env server.mjs",
    "typecheck": "vue-tsc --noEmit",
    "fonts:build": "node scripts/build-font-css.mjs",
    "fonts:check": "node scripts/build-font-css.mjs --check",
    "styles:check": "stylelint \"public/styles/**/*.css\" \"src/**/*.vue\" --max-warnings 0",
    "build": "npm run fonts:build && vite build && node -e \"require('node:fs').copyFileSync('LICENSE', 'dist/LICENSE')\"",
    "preview": "vite preview --host 127.0.0.1 --port 3217 --strictPort",
    "check": "npm run typecheck && npm run test:unit && npm run build",
    "test:unit": "node --test tests/*.test.mjs",
    "test:shell": "npm run build && node scripts/test-browser.mjs shell",
    "test:services": "node scripts/test-browser.mjs services",
    "test:shared": "node scripts/test-browser.mjs shared",
    "test:drawing": "node scripts/test-browser.mjs drawing",
    "test:workspaces": "node scripts/test-browser.mjs workspaces",
    "test:home": "node scripts/test-browser.mjs home",
    "test:native": "node scripts/test-browser.mjs native",
    "test:ask": "node scripts/test-browser.mjs ask",
    "test:bridge": "node scripts/test-browser.mjs bridge",
    "test:local": "node scripts/test-browser.mjs local",
    "test:release": "node --test tests/release.package.mjs",
    "package": "npm run build && node scripts/package-release.mjs",
    "deploy:pages": "npm run build && npx --yes wrangler@4.151.1 pages deploy --branch main",
    "test:browser": "npm run build && node scripts/test-browser.mjs",
    "test:browser:all": "npm run build && node scripts/test-browser.mjs --all",
    "test:edit": "node scripts/test-browser.mjs editor ask-edit director-tools native-nai-edit native-nai-enhance native-nai-focus"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "entities": "7.0.1",
    "marked": "18.1.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "playwright": "1.62.1",
    "postcss-html": "2.0.0",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
