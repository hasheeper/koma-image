{
  "name": "koma-image",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Image creation workspaces with a configurable gateway protocol",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "npm run fonts:build && vite",
    "start": "node --env-file-if-exists=.env server.mjs",
    "typecheck": "vue-tsc --noEmit",
    "fonts:build": "node scripts/build-font-css.mjs",
    "fonts:check": "node scripts/build-font-css.mjs --check",
    "styles:check": "stylelint \"public/styles/**/*.css\" \"src/**/*.vue\" --max-warnings 0",
    "build": "npm run fonts:build && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3217 --strictPort",
    "check": "npm run fonts:check && npm run styles:check && npm run typecheck && npm run test:unit && npm run build",
    "test:unit": "node --test tests/*.test.mjs",
    "test:shell": "npm run build && node --test tests/shell.browser.mjs",
    "test:services": "node --test tests/services.browser.mjs",
    "test:shared": "node --test tests/shared.browser.mjs",
    "test:drawing": "node --test tests/drawing.browser.mjs",
    "test:workspaces": "node --test tests/workspaces.browser.mjs",
    "test:home": "node --test --test-concurrency=1 tests/home.browser.mjs tests/home-ui.browser.mjs tests/home-ask.browser.mjs",
    "test:native": "node --test tests/native-protocols.browser.mjs",
    "test:ask": "node --test tests/ask.browser.mjs",
    "test:bridge": "node --test tests/bridge.browser.mjs",
    "test:local": "node --test tests/local.browser.mjs",
    "test:release": "node --test tests/release.package.mjs",
    "package": "npm run build && node scripts/package-release.mjs",
    "deploy:pages": "npm run build && npx --yes wrangler@4.151.1 pages deploy --branch main"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "entities": "7.0.1",
    "marked": "18.1.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "playwright": "1.62.1",
    "postcss-html": "2.0.0",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
