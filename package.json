{
  "name": "koma-image",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Image creation workspaces with a configurable gateway protocol",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3217 --strictPort",
    "check": "npm run typecheck && npm run test:unit && npm run build",
    "test:unit": "node --test tests/*.test.mjs",
    "test:shell": "npm run build && node --test tests/shell.browser.mjs",
    "test:services": "node --test tests/services.browser.mjs"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
