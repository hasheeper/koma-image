# Optional local server only. Never expose these through VITE_*.
# Each URL/Key pair is optional and must be set together. All empty = browser configuration.
KOMA_GATEWAY_URL=
KOMA_GATEWAY_KEY=
# ASK reasoning connections; independent of the image gateway.
KOMA_ASK_OPENAI_URL=
KOMA_ASK_OPENAI_KEY=
KOMA_ASK_ANTHROPIC_URL=
KOMA_ASK_ANTHROPIC_KEY=
# Loopback port and optional URL subdirectory. The server binds 127.0.0.1 only.
KOMA_PORT=3218
KOMA_BASE_PATH=/
