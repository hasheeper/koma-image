# Optional local server only. Never expose these through VITE_*.
# Set both to enable the same-origin gateway. Leave both empty for browser configuration.
KOMA_GATEWAY_URL=
KOMA_GATEWAY_KEY=
# Loopback port and optional URL subdirectory. The server binds 127.0.0.1 only.
KOMA_PORT=3218
KOMA_BASE_PATH=/
